# Media UBWC
import /vendor_extra/build.prop vendor.gralloc.disable_ubwc

# i.MX8MM graphics. The host provisioning layer pins gralloc.gbm.device to the
# render node whose kernel driver is etnaviv. Vulkan is intentionally absent.
ro.hardware.egl=mesa
ro.hardware.gralloc=minigbm_gbm_mesa
ro.hardware.hwcomposer=waydroid
ro.opengles.version=196609

# Audio
af.thread.throttle=false
audio.deep_buffer.media=true

# Codec2
debug.stagefright.c2inputsurface=-1

# AOSP 2 GB Dalvik profile. Android, Linux and graphics share the physical RAM.
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# Avoid optional GPU effects that consume buffers and memory bandwidth.
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.running_without_sync_framework=true
ro.surface_flinger.supports_background_blur=0
ro.surface_flinger.vsync_event_phase_offset_ns=2000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=6000000
ro.sf.blurs_are_expensive=1
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1

# Use Android 16's PSI-based userspace lmkd strategy. The host kernel profile
# supplies PSI, memory cgroups, swap accounting and compressed zram.
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100

# Disable the optional Material 3 expressive effects on the kiosk profile.
is_expressive_design_enabled=false
